<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:storm="http://storm.bpmn2.ru/ns" id="Definitions_Planetarium" targetNamespace="http://bpmn.io/schema/bpmn" exporter="StormBPMN" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Planetarium" name="Купольный проекционный комплекс планетария" processRef="Process_Planetarium" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Planetarium" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_ContentManager" name="Контент-менеджер">
        <bpmn:flowNodeRef>Task_LoadMedia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_ScheduleApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reencode</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Engineer" name="Дежурный инженер">
        <bpmn:flowNodeRef>Task_HardwareAdjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartDiag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveProfile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operator" name="Оператор сеанса">
        <bpmn:flowNodeRef>Task_StartSession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoadScript</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestRun</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система управления проекциями">
        <bpmn:flowNodeRef>Task_LogTelemetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MediaValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateMedia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Playback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SessionDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalcWarpBlend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CalibrationOk</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_HardwareAdjust" name="Произвести аппаратную юстировку оптических осей">
      <bpmn:incoming>Flow_CalibError</bpmn:incoming>
      <bpmn:outgoing>Flow_LoopAdjust</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_LogTelemetry" name="Зафиксировать телеметрию сеанса и сформировать отчет">
      <bpmn:incoming>Flow_ToTelemetry</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1daztfq">
        <bpmn:targetRef>DORef_TelemetryLog</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_ScheduleApproved" targetRef="Task_LoadMedia" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_LoadMedia" targetRef="Task_ValidateMedia" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ValidateMedia" targetRef="Gateway_MediaValid" />
    <bpmn:sequenceFlow id="Flow_MediaInvalid" name="Нет (ошибка формата)" sourceRef="Gateway_MediaValid" targetRef="Task_Reencode" />
    <bpmn:sequenceFlow id="Flow_LoopReencode" sourceRef="Task_Reencode" targetRef="Task_LoadMedia" />
    <bpmn:sequenceFlow id="Flow_MediaValid" name="Да (валиден)" sourceRef="Gateway_MediaValid" targetRef="Gateway_Split" storm:LabelWidth="65" storm:LabelHeight="14" />
    <bpmn:sequenceFlow id="Flow_ToEngineer" sourceRef="Gateway_Split" targetRef="Task_StartDiag" />
    <bpmn:sequenceFlow id="Flow_ToOperator" sourceRef="Gateway_Split" targetRef="Task_LoadScript" />
    <bpmn:sequenceFlow id="Flow_ToCalcWarp" sourceRef="Task_StartDiag" targetRef="Task_LoadScript" />
    <bpmn:sequenceFlow id="Flow_ToCalibGateway" sourceRef="Task_CalcWarpBlend" targetRef="Gateway_CalibrationOk" />
    <bpmn:sequenceFlow id="Flow_CalibError" name="Нет (дрейф &#62; 2 px)" sourceRef="Gateway_CalibrationOk" targetRef="Task_HardwareAdjust" />
    <bpmn:sequenceFlow id="Flow_LoopAdjust" sourceRef="Task_HardwareAdjust" targetRef="Task_StartDiag" />
    <bpmn:sequenceFlow id="Flow_CalibOk" name="Да (RMS ≤ 2 px)" sourceRef="Gateway_CalibrationOk" targetRef="Task_ApproveProfile" storm:LabelWidth="78" storm:LabelHeight="14" />
    <bpmn:sequenceFlow id="Flow_EngDone" sourceRef="Task_ApproveProfile" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_ToTestRun" sourceRef="Task_LoadScript" targetRef="Task_TestRun" />
    <bpmn:sequenceFlow id="Flow_OpDone" sourceRef="Task_TestRun" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_ToStart" sourceRef="Gateway_Join" targetRef="Task_StartSession" />
    <bpmn:sequenceFlow id="Flow_ToPlayback" sourceRef="Task_StartSession" targetRef="Task_Playback" />
    <bpmn:sequenceFlow id="Flow_ToTelemetry" sourceRef="Task_Playback" targetRef="Task_LogTelemetry" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_LogTelemetry" targetRef="EndEvent_SessionDone" />
    <bpmn:userTask id="Task_LoadMedia" name="Загрузить медиапакет программы на медиасервер">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_LoopReencode</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:property id="Property_0i7u4wg" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1jgen97">
        <bpmn:sourceRef>DORef_Schedule</bpmn:sourceRef>
        <bpmn:targetRef>Property_0i7u4wg</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0faqc31">
        <bpmn:targetRef>DORef_MediaPackage</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_ScheduleApproved" name="Суточное расписание сеансов утверждено">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Reencode" name="Перекодировать медиаресурс и исправить метаданные">
      <bpmn:incoming>Flow_MediaInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_LoopReencode</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1ynnro6" sourceRef="Task_LoadScript" targetRef="Task_CalcWarpBlend" />
    <bpmn:userTask id="Task_StartDiag" name="Запустить предсеансовую диагностику проекторов">
      <bpmn:incoming>Flow_ToEngineer</bpmn:incoming>
      <bpmn:incoming>Flow_LoopAdjust</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCalcWarp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LoadScript" name="Загрузить сценарий программы в плейлист показа">
      <bpmn:incoming>Flow_ToOperator</bpmn:incoming>
      <bpmn:incoming>Flow_ToCalcWarp</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTestRun</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ynnro6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Split" name="Разделение регламента">
      <bpmn:incoming>Flow_MediaValid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEngineer</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToOperator</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_MediaValid" name="Медиафайлы валидны?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_MediaInvalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_MediaValid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ValidateMedia" name="Валидировать медиапакет программы">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0yn4bk9">
        <bpmn:targetRef>DORef_ValidationReport</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_StartSession" name="Подать команду старта сеанса">
      <bpmn:incoming>Flow_ToStart</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPlayback</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ApproveProfile" name="Утвердить применение профиля калибровки">
      <bpmn:incoming>Flow_CalibOk</bpmn:incoming>
      <bpmn:outgoing>Flow_EngDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Join" name="Синхронизация готовности">
      <bpmn:incoming>Flow_EngDone</bpmn:incoming>
      <bpmn:incoming>Flow_OpDone</bpmn:incoming>
      <bpmn:outgoing>Flow_ToStart</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:dataObjectReference id="DORef_CalibrationProfile" name="Обновленный профиль калибровки" dataObjectRef="DO_CalibrationProfile" />
    <bpmn:dataObject id="DO_CalibrationProfile" />
    <bpmn:dataObjectReference id="DORef_MediaPackage" name="Медиапакет программы (Dome Master)" dataObjectRef="DO_MediaPackage" />
    <bpmn:dataObject id="DO_MediaPackage" />
    <bpmn:dataObjectReference id="DORef_Schedule" name="Суточное расписание" dataObjectRef="DO_Schedule" />
    <bpmn:dataObject id="DO_Schedule" />
    <bpmn:serviceTask id="Task_Playback" name="Синхронно воспроизвести многоканальный медиапоток с наложением шейдеров деформации">
      <bpmn:incoming>Flow_ToPlayback</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTelemetry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_SessionDone" name="Полнокупольный показ завершен, телеметрия сохранена в БД">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DORef_TelemetryLog" name="Журнал телеметрии сеанса" dataObjectRef="DO_TelemetryLog" />
    <bpmn:dataObject id="DO_TelemetryLog" />
    <bpmn:dataObjectReference id="DORef_ValidationReport" name="Протокол валидации" dataObjectRef="DO_ValidationReport" />
    <bpmn:dataObject id="DO_ValidationReport" />
    <bpmn:userTask id="Task_TestRun" name="Провести тестовый предстартовый прогон звука и проекции">
      <bpmn:incoming>Flow_ToTestRun</bpmn:incoming>
      <bpmn:outgoing>Flow_OpDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CalcWarpBlend" name="Рассчитать сетку геометрической деформации и маски сшивки">
      <bpmn:incoming>Flow_1ynnro6</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCalibGateway</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_00dip7n">
        <bpmn:targetRef>DORef_CalibrationProfile</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CalibrationOk" name="Погрешность оптического сведения в норме?">
      <bpmn:incoming>Flow_ToCalibGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_CalibError</bpmn:outgoing>
      <bpmn:outgoing>Flow_CalibOk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
